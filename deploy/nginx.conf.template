# nginx: landing page at "/", Streamlit app at "/app/" (same origin, one port).
worker_processes 1;
pid /tmp/nginx.pid;
error_log /dev/stderr warn;
events { worker_connections 512; }

http {
  include       /etc/nginx/mime.types;
  default_type  application/octet-stream;
  access_log    off;
  sendfile      on;
  gzip          on;
  gzip_types    text/css application/javascript image/svg+xml;
  client_max_body_size 50m;   # sales export uploads

  map $http_upgrade $connection_upgrade { default upgrade; '' close; }

  server {
    listen ${PORT};
    server_name _;

    root ${APP_ROOT}/landing;
    index index.html;

    location = /healthz { access_log off; return 200 "ok\n"; }

    # Landing page and its assets (long cache for vendored files)
    # Business logo shared by landing page and app (put the file in assets/)
    location /assets/ { alias ${APP_ROOT}/assets/; expires 1d; }

    location /vendor/ { expires 30d; add_header Cache-Control "public"; }
    location / { try_files $uri $uri/ /index.html; }

    # Streamlit app (HTTP + WebSocket)
    location = /app { return 301 /app/; }
    location /app/ {
      proxy_pass http://127.0.0.1:8501;
      proxy_http_version 1.1;
      proxy_set_header Upgrade $http_upgrade;
      proxy_set_header Connection $connection_upgrade;
      proxy_set_header Host $host;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_set_header X-Forwarded-Proto $scheme;
      proxy_read_timeout 86400;
      proxy_buffering off;
    }
  }
}
